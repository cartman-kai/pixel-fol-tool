// 必须在任何 include 之前声明代码页：否则中文注释会按系统 ANSI 代码页解析，
// 可能吞掉行尾换行符，导致后续 #ifndef 等预处理指令失效（中文系统尤其明显）
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "winres.h"

// ============================================================
// 0. 图标 (EXE 文件图标)
// ============================================================
IDI_MAIN_ICON           ICON                    "FolG.ico"

// ============================================================
// 1. 设置界面语言
// ============================================================
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// ============================================================
// 2. 字符串表 (多语言支持)
// 窗口与控件由 FolToolWin.cpp 手工创建，文案统一取自字符串表。
// ============================================================

// 默认语言也使用中文，避免非中文系统下控件回退到英文。
STRINGTABLE LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
BEGIN
IDS_APP_TITLE       "FOL 游戏资源工具 - v1.0.1"
IDS_TAB_UNPACK      "解包"
IDS_TAB_PACK        "打包"
IDS_LBL_FOL_FILE    "FOL 文件:"
IDS_LBL_OUT_DIR     "输出目录:"
IDS_LBL_IN_DIR      "资源目录:"
IDS_LBL_SAVE_TO     "保存到:"
IDS_BTN_BROWSE      "浏览..."
IDS_BTN_UNPACK      "开始解包"
IDS_BTN_PACK        "开始打包"
IDS_LBL_LOG         "状态日志:"
IDS_COL_PATH        "文件路径"
IDS_COL_SIZE        "大小"
IDS_ST_NO_FILE      "未选择 .fol 文件。"
IDS_ST_FILES        "共 %d 个文件"
IDS_READY           "准备就绪。"
IDS_ERR_NO_FOL      "请先选择一个 .fol 文件。"
IDS_ERR_NO_DIR      "请先选择一个目录。"
IDS_SUCCESS         "操作成功完成！"
IDS_ERR_BUSY        "任务进行中，请稍候。"
IDS_TAB_ABOUT       "关于"
IDS_ABOUT_VERSION   "版本"
IDS_ABOUT_AUTHOR    "作者"
END

